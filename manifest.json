{
  "manifest_version": 3,
  "name": "Investiční klub — import portfolia",
  "version": "0.7.3",
  "description": "Importuje hodnotu a pozice z eToro, IBKR, Trading 212, Portu, Fio, Anycoin, XTB a George ČS (fondy i akcie) do Investičního klubu.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Import portfolia do Investičního klubu",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://www.etoro.com/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/etoro.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.interactivebrokers.com/*",
        "https://*.interactivebrokers.co.uk/*",
        "https://*.interactivebrokers.ie/*"
      ],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/ibkr.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.portu.cz/*"],
      "js": ["content/brokers/portu-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.portu.cz/*", "https://www.portu.cz/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/portu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ebroker.fio.cz/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/fio.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.anycoin.cz/*", "https://anycoin.cz/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/anycoin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://george.csas.cz/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/george.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.trading212.com/*"],
      "js": ["content/brokers/t212-api.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.trading212.com/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/t212.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://xstation5.xtb.com/*"],
      "js": ["content/brokers/xtb-stream.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://xstation5.xtb.com/*"],
      "js": ["lib/diagnostics.js", "lib/normalize.js", "content/brokers/xtb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://investicni-klub.lovable.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["lib/diagnostics.js", "content/club.js"],
      "run_at": "document_idle"
    }
  ]
}
